{
	"name": "KZChatbot",
	"version": "0.0.2",
	"author": [ "Joel R. ([https://www.kolzchut.org.il Kol-Zchut])" ],
	"url": "https://github.com/kolzchut/mediawiki-extensions-KZChatbot",
	"descriptionmsg": "kzchatbot-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.35.0",
		"platform": {
			"ext-curl": "*"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\KZChatbot\\": "src/"
	},
	"config": {
		"KZChatbotLlmApiUrl": {
			"description": "LLM API URL",
			"value": null
		},
		"KZChatbotLlmApiTimeout": {
			"value": 120,
			"description": "Timeout in seconds for requests to the RAG backend's /search endpoint. The LLM judge + answer steps can take well over the default HTTP timeout, so this is set higher to avoid premature timeouts while the backend is still answering.",
			"public": false
		},
		"KZChatbotUserLimitBypassToken": {
			"value": false,
			"description": "Secret token that allows bypassing the active users limit when provided as a URL parameter. Set to false to disable the bypass feature.",
			"public": false
		},
		"KZChatbotAutoOpenParam": {
			"value": "autoOpenChatbot",
			"description": "URL parameter that triggers the chatbot to open automatically. Set to an empty string to disable this feature.",
			"public": true
		},
		"KZChatbotSendPageId": {
			"value": true,
			"description": "Whether to send page_id as additional context to the RAG backend. Set to false to disable sending page context.",
			"public": true
		},
		"KZChatbotReplaceAnswerWhenNoLinks": {
			"value": false,
			"description": "When true, replaces the LLM answer with the 'returning_links_empty' slug when no links are returned. When false, always shows the LLM answer.",
			"public": true
		}
	},
	"ConfigRegistry": {
		"KZChatbot": "GlobalVarConfig::newInstance"
	},
	"AvailableRights": [
		"kzchatbot-edit-settings",
		"kzchatbot-testing",
		"kzchatbot-edit-rag-settings",
		"kzchatbot-no-limits",
		"kzchatbot-view-settings",
		"kzchatbot-view-rag-settings",
		"kzchatbot-clean-redis-history"
	],
	"GroupPermissions": {
		"chatbot-admin": {
			"kzchatbot-edit-settings": true,
			"kzchatbot-view-rag-settings": true,
			"kzchatbot-edit-rag-settings": true,
			"kzchatbot-clean-redis-history": true,
			"kzchatbot-testing": true,
			"kzchatbot-no-limits": true
		},
		"chatbot-settings-viewer": {
			"kzchatbot-view-settings": true,
			"kzchatbot-view-rag-settings": true
		}
	},
	"SpecialPages": {
		"KZChatbotSettings": "MediaWiki\\Extension\\KZChatbot\\SpecialKZChatbotSettings",
		"KZChatbotSlugs": "MediaWiki\\Extension\\KZChatbot\\SpecialKZChatbotSlugs",
		"KZChatbotBannedWords": "MediaWiki\\Extension\\KZChatbot\\SpecialKZChatbotBannedWords",
		"KZChatbotRagSettings": "MediaWiki\\Extension\\KZChatbot\\SpecialKZChatbotRagSettings",
		"KZChatbotTesting": "MediaWiki\\Extension\\KZChatbot\\SpecialKZChatbotTesting"
	},
	"HookHandlers": {
		"KZChatbotHooks": {
			"class": "MediaWiki\\Extension\\KZChatbot\\Hooks"
		}
	},
	"Hooks": {
		"BeforePageDisplay": "KZChatbotHooks",
		"LoadExtensionSchemaUpdates": "KZChatbotHooks",
		"ResourceLoaderGetConfigVars": "KZChatbotHooks"
	},
	"ResourceModules": {
		"ext.KZChatbot.form": {
			"localBasePath": "resources/ext.KZChatbot.form",
			"remoteExtPath": "KZChatbot/resources/ext.KZChatbot.form",
			"scripts": [ "convertmessagebox.js" ],
			"styles": [ "forms.css" ],
			"dependencies": [ "mediawiki.notification.convertmessagebox" ]
		},
		"ext.KZChatbot.launcher": {
			"es6": true,
			"localBasePath": "resources/ext.KZChatbot.launcher",
			"remoteExtPath": "KZChatbot/resources/ext.KZChatbot.launcher",
			"scripts": [ "kzChatbotLauncher.js" ],
			"dependencies": [
				"mediawiki.cookie"
			]
		},
		"ext.KZChatbot.bot": {
			"es6": true,
			"localBasePath": "resources/ext.KZChatbot.bot",
			"remoteExtPath": "KZChatbot/resources/ext.KZChatbot.bot",
			"scripts": "index.js"
		},
		"ext.KZChatbot.bot.styles": {
			"localBasePath": "resources/ext.KZChatbot.bot",
			"remoteExtPath": "KZChatbot/resources/ext.KZChatbot.bot",
			"styles": [
				"overrides.less"
			]
		},
		"ext.KZChatbot.ragui.styles": {
			"localBasePath": "resources/ext.KZChatbot.ragui",
			"remoteExtPath": "KZChatbot/resources/ext.KZChatbot.ragui",
			"styles": [ "styles.css" ]
		}
	},
	"RestRoutes": [
		{
			"path": "/kzchatbot/v0/status",
			"class": "MediaWiki\\Extension\\KZChatbot\\ApiKZChatbotGetStatus",
			"method": "GET"
		},
		{
			"path": "/kzchatbot/v0/question",
			"class": "MediaWiki\\Extension\\KZChatbot\\ApiKZChatbotSubmitQuestion",
			"method": "POST"
		},
		{
			"path": "/kzchatbot/v0/rate",
			"class": "MediaWiki\\Extension\\KZChatbot\\ApiKZChatbotRateAnswer",
			"method": "POST"
		},
		{
			"path": "/kzchatbot/v0/ragui/admin",
			"method": "GET",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagUiHandler",
			"backendFile": "admin.html",
			"viewRight": "kzchatbot-view-rag-settings",
			"editRight": "kzchatbot-edit-rag-settings"
		},
		{
			"path": "/kzchatbot/v0/ragui/index",
			"method": "GET",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagUiHandler",
			"backendFile": "index.html",
			"viewRight": "kzchatbot-testing"
		},
		{
			"path": "/kzchatbot/v0/ragui/batch",
			"method": "GET",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagUiHandler",
			"backendFile": "batch-runner.html",
			"viewRight": "kzchatbot-testing"
		},
		{
			"path": "/kzchatbot/v0/ragproxy/get_config",
			"method": "GET",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "get_config",
			"right": "kzchatbot-view-rag-settings"
		},
		{
			"path": "/kzchatbot/v0/ragproxy/set_config",
			"method": "POST",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "set_config",
			"right": "kzchatbot-edit-rag-settings",
			"write": true
		},
		{
			"path": "/kzchatbot/v0/ragproxy/clean_redis_history",
			"method": "POST",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "clean_redis_history",
			"right": "kzchatbot-clean-redis-history",
			"write": true
		},
		{
			"path": "/kzchatbot/v0/ragproxy/ping/redis",
			"method": "GET",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "ping/redis",
			"right": "kzchatbot-view-rag-settings"
		},
		{
			"path": "/kzchatbot/v0/ragproxy/ping/llm_manager",
			"method": "GET",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "ping/llm_manager",
			"right": "kzchatbot-view-rag-settings"
		},
		{
			"path": "/kzchatbot/v0/ragproxy/ping/es_docker",
			"method": "GET",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "ping/es_docker",
			"right": "kzchatbot-view-rag-settings"
		},
		{
			"path": "/kzchatbot/v0/ragproxy/search",
			"method": "POST",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "search",
			"right": "kzchatbot-testing",
			"write": true
		},
		{
			"path": "/kzchatbot/v0/ragproxy/search/stream",
			"method": "POST",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "search/stream",
			"right": "kzchatbot-testing",
			"write": true
		},
		{
			"path": "/kzchatbot/v0/ragproxy/rating",
			"method": "POST",
			"class": "MediaWiki\\Extension\\KZChatbot\\Rest\\RagProxyHandler",
			"backendPath": "rating",
			"right": "kzchatbot-testing",
			"write": true
		}
	],
	"ExtensionMessagesFiles": {
		"KZChatbotLinksAliases": "KZChatbot.i18n.alias.php"
	},
	"MessagesDirs": {
		"KZChatbot": [ "i18n" ]
	},
	"manifest_version": 2
}
